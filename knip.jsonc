{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts", "*.mjs", "*.mts", "tests/e2e/**/*.ts", "tests/e2e/**/*.mts"],
  "entry": ["tests/e2e/**/*.e2e.ts"],
  "ignoreDependencies": [
    // wdio services/frameworks/drivers referenced by plugin-name string in the wdio
    // configs (`services: ['obsidian', ['appium', ...]]`, `framework: 'mocha'`), not
    // by import — knip can't trace those.
    "@wdio/appium-service",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "wdio-obsidian-reporter",
    // Agent tooling, not plugin code: launched through .ai/codegraph.mjs by
    // the agent MCP/hook configs and `prepare`, which knip doesn't scan.
    "@colbymchenry/codegraph",
  ],
  "include": ["files", "dependencies", "unlisted", "unresolved", "exports", "types", "duplicates"],
}
