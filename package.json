{
  "name": "your-id-here",
  "version": "0.1.0",
  "private": true,
  "description": "Describe what this does in one sentence.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready && pnpm run test:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint '**/*.css'",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mts",
    "test:e2e:android": "wdio run tests/e2e/wdio.mobile.conf.mts",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm typecheck && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm typecheck:e2e && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:check",
    "ci": "pnpm verify",
    "codegraph:setup": "node .ai/setup-codegraph.mjs",
    "prepare": "husky && node .ai/setup.mjs && node .ai/setup-codegraph.mjs"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 524288
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.7.0",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "expect-webdriverio": "6.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "mocha": "10.8.2",
    "obsidian": "latest",
    "obsidian-test-mocks": "^6.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wdio-obsidian-reporter": "3.2.1",
    "wdio-obsidian-service": "3.2.1",
    "webdriverio": "9.32.0"
  }
}
