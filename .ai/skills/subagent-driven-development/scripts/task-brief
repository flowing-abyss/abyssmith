#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context. Prepends the plan's Global Constraints
# section (from the plan header) so project-wide requirements — and any
# optional requirement sections a custom skill added to this task's own
# block — reach the implementer in the same file as the task text, instead
# of depending on the controller to restate them by hand.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# Global Constraints: from its own heading to the next heading of the same
# or shallower level (or the header's closing "---", whichever comes first).
awk '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Global Constraints/ {
    inconstraints = 1; level = match($0, /[^#]/) - 1; print; next
  }
  !infence && inconstraints && /^#+[ \t]/ {
    thislevel = match($0, /[^#]/) - 1
    if (thislevel <= level) { inconstraints = 0 }
  }
  !infence && inconstraints && /^---[ \t]*$/ { inconstraints = 0 }
  inconstraints { print }
' "$plan" > "$out.constraints"

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan" > "$out.task"

if [ ! -s "$out.task" ]; then
  rm -f "$out.constraints" "$out.task"
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

if [ -s "$out.constraints" ]; then
  cat "$out.constraints" "$out.task" > "$out"
else
  cp "$out.task" "$out"
fi
rm -f "$out.constraints" "$out.task"

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
